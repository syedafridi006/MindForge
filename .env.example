# Supabase: Project Settings -> API
# These are SERVER-ONLY variables. Do not prefix them with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET

# Private MindForge access. Use a long, unique passcode (16+ characters).
MF_ACCESS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PRIVATE_PASSPHRASE

# Session-signing secret: generate with the PowerShell command in README.md.
# Must be at least 32 characters; keep it stable or all sessions will expire.
MF_SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
